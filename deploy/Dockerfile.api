# syntax=docker/dockerfile:1

# Base images are pinned by digest: the :latest tags are mutable, so an
# unpinned build is not reproducible.
FROM --platform=$BUILDPLATFORM ghcr.io/tesserix/base-go-builder:latest@sha256:63086000b8d00b95ff9312080d4d1f0d64475039ff81db67a2cda5db70c23d48 AS build
USER 0:0
WORKDIR /src
ENV GOTOOLCHAIN=go1.27.4
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api/ ./
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags "-s -w" -trimpath -o /out/onboarding-api ./cmd/server

# distroless has no shell to adduser, so the passwd/group entries are made here.
RUN addgroup -g 1000 onboarding \
    && adduser -u 1000 -G onboarding -D -H onboarding

FROM ghcr.io/tesserix/base-distroless-static:latest@sha256:bd65dd61664f24e0e70b80881b5e75559ff0d98b1d99a2d2f61365b0dcf828d2 AS runtime
WORKDIR /app
COPY --from=build /etc/passwd /etc/group /etc/
COPY --from=build --chown=onboarding:onboarding /out/onboarding-api /app/onboarding-api
ENV PORT=8080
EXPOSE 8080
# Numeric so Kubernetes' runAsNonRoot check can verify uid>0 at admission.
USER 1000:1000
ENTRYPOINT ["/app/onboarding-api"]
